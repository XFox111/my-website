# Build-time variables
NEXT_PUBLIC_CLARITY_ID=											# Microsoft Clarity project ID
NEXT_PUBLIC_TURNSTILE_SITEKEY=3x00000000000000000000FF			# Cloudflare Turnstile site key

# Runtime variables
CF_TURNSTILE_SECRETKEY=1x0000000000000000000000000000000AA		# Cloudflare Turnstile secret key for token verification
SMTP_HOST=smtp.example.com				# Address of your SMTP server
SMTP_PORT=587							# Port of your SMTP server
SMTP_USER=username						# Username of your email bot account (usually same, as email address)
SMTP_PASSWORD=password					# Password of your email bot account
SMTP_FROM_EMAIL=no-reply@example.com	# Email address which will be displayed in "From" field
SMTP_TO_EMAIL=johndoe@example.com		# Email to which emails will be sent
